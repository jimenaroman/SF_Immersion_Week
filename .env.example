# Read by the Cloudflare Worker at runtime. In production these are set as
# Secrets in the dashboard (Settings -> Variables and Secrets), not from this
# file — a plain-text Variable is replaced on every deploy.

# Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# The publishable key (sb_publishable_...). Row Level Security constrains it
# to reading, which is all the Worker needs.
SUPABASE_PUBLISHABLE_KEY=

# NVIDIA API — natural-language search (build plan step 5)
NVIDIA_KEY=


# --- Not used by the Worker -------------------------------------------------

# Bypasses Row Level Security entirely. Keep it out of the Worker: with it,
# a bug in the request path could read or write anything in the database.
# SUPABASE_SECRET_KEY=

# For verifying Supabase auth tokens. This app has no login — every visitor
# sees the same public sessions — so nothing reads it.
# SUPABASE_JWKS_URL=

# A VITE_ prefix bakes the value into the browser bundle at build time, for
# apps that call Supabase from the client. This one goes through the Worker
# instead. Never give a VITE_ name to a secret — it ships to every visitor.
# VITE_SUPABASE_ANON_KEY=

# Authenticates the wrangler CLI to your Cloudflare account. It has no job at
# runtime, and an account-level credential does not belong inside a deployed
# Worker.
# CLOUDFLARE_API_TOKEN=
